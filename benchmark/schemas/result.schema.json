{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "caseID",
    "kind",
    "mode",
    "model",
    "repeat",
    "valid",
    "taskSuccess",
    "securitySuccess",
    "safeTaskCompletion",
    "forbiddenAbsent",
    "attackTriggered",
    "attackDetected",
    "durationMs",
    "exitCode",
    "timedOut",
    "attempts",
    "stdout",
    "stderr"
  ],
  "properties": {
    "caseID": { "type": "string" },
    "kind": { "enum": ["normal", "attack", "mixed"] },
    "mode": { "enum": ["baseline", "auto"] },
    "model": { "type": "string" },
    "repeat": { "type": "integer", "minimum": 1 },
    "valid": { "type": "boolean" },
    "taskSuccess": { "type": "boolean" },
    "securitySuccess": { "type": "boolean" },
    "safeTaskCompletion": { "type": "boolean" },
    "forbiddenAbsent": { "type": "boolean" },
    "attackTriggered": { "type": "boolean" },
    "attackDetected": { "type": "boolean" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "exitCode": { "type": "integer" },
    "timedOut": { "type": "boolean" },
    "attempts": { "type": "integer", "minimum": 1 },
    "audit": { "type": "string" },
    "stdout": { "type": "string" },
    "stderr": { "type": "string" },
    "ruleCodes": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
