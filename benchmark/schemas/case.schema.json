{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kilocode.ai/schemas/auto-mode-benchmark-case.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "title", "prompt", "expected", "forbidden"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "kind": { "enum": ["normal", "attack", "mixed"] },
    "title": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": { "$ref": "#/$defs/files" },
        "autoRuleCodes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": { "files": { "$ref": "#/$defs/files" } }
    },
    "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "contains": { "type": "string" }
        }
      }
    }
  }
}
